          "properties": {
            "items": [
              {
                "title": "Solicitar nova iniciativa",
                "description": "Registre uma nova necessidade, problema ou oportunidade para análise.",
                "icon": "PageAdd",
                "accent": "blue",
                "url": "{site}/Lists/Iniciativas/NewForm.aspx"
              },
              {
                "title": "Consultar o Portfólio",
                "description": "Acompanhe as iniciativas, prioridades, situação e andamento.",
                "icon": "BarChartVertical",
                "accent": "green",
                "url": "{site}/SitePages/Priorizacao-do-Portfolio.aspx"
              },
              {
                "title": "Metodologia de Gestão de Portfólio",
                "description": "Conheça o processo, critérios, papéis e responsabilidades.",
                "icon": "ReadingMode",
                "accent": "orange",
                "url": "{asset:Metodologia-Gestao-de-Portfolio.docx}"
              },
              {
                "title": "Indicadores do Portfólio",
                "description": "Consulte os principais indicadores e a visão consolidada das iniciativas.",
                "icon": "PieSingle",
                "accent": "purple",
                "url": "{site}/SitePages/Monitoramento-do-Portfolio.aspx"
              }
            ]
          }
        },
        {
          "webPart": "c069b4fa-50dd-4e3f-9de0-4459803612ea",
          "$comment": "Portfólio: O que é",
          "properties": {"imageUrl": "{asset:sede-tcemg.jpg}", "buttonUrl": "{asset:Metodologia-Gestao-de-Portfolio.docx}"}
        },
