    "earlyTermination": { "min": 5, "max": 15 },
    "riskMax": 3.0,
    "concentrationSharePercent": 50,
    "lowRiskLevel": 2.0,
    "innovationMinSharePercent": 15
  },

  "objectives": [
    { "name": "Gestão e Governança", "priority": true, "active": true },
